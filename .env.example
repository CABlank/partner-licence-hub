# Local Docker database (docker compose up -d). Copy to .env.local.
# The app connects as hub_app, an unprivileged role, never as postgres.
DATABASE_URL=postgresql://hub_app:hub_app@localhost:5433/licence_hub
DISPATCHER_DATABASE_URL=postgresql://hub_dispatcher:hub_dispatcher@localhost:5433/licence_hub
# Analytics: dbt marts on the SIMULATED database, read-only user.
ANALYTICS_DATABASE_URL=postgresql://hub_analytics:hub_analytics@localhost:5433/licence_hub_sim
